# Copy this file to `.env` (already gitignored) and fill in real values.
# Never commit the real .env file or paste real keys into chat/tickets.

GEMINI_API_KEY=your-gemini-api-key-here

# Comma-separated list of allowed frontend origins for CORS (e.g. your Vercel URL).
# Unset defaults to the local Vite dev server only — never "*" in production.
FRONTEND_ORIGINS=https://your-app.vercel.app
