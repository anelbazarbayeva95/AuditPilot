# Copy this file to `.env` (already gitignored) and fill in real values.
# Never commit the real .env file or paste real keys into chat/tickets.

GEMINI_API_KEY=your-gemini-api-key-here

# Comma-separated list of frontend origins allowed to call this API.
# Defaults to http://localhost:5173 if unset — set this to your real
# deployed frontend origin(s) in production.
ALLOWED_ORIGINS=http://localhost:5173,https://audit-pilot-ten.vercel.app

# --- Capacity and abuse limits (all optional; defaults shown) ---
# Each audit runs three headless Chromium instances. Audits past this many
# wait in a queue; past MAX_QUEUED_AUDITS waiting, new ones get HTTP 503.
MAX_CONCURRENT_AUDITS=2
MAX_QUEUED_AUDITS=10
# Finished reports are held in memory this long (and at most this many), so
# the results page can be refreshed/revisited. After that: 404, re-run.
JOB_RETENTION_SECONDS=3600
MAX_RETAINED_JOBS=100
# Per-client limit on *starting* audits (polling/results aren't limited).
AUDIT_RATE_LIMIT=10
AUDIT_RATE_WINDOW_SECONDS=3600
# Number of reverse proxies in front of the app. Behind Azure Container Apps
# ingress set this to 1, or every visitor shares the proxy's address and one
# rate-limit bucket. Leave 0 when clients connect directly (X-Forwarded-For is
# then ignored, since clients could forge it).
TRUSTED_PROXY_HOPS=0
