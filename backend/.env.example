# Copy this file to `.env` (already gitignored) and fill in real values.
# Never commit the real .env file or paste real keys into chat/tickets.

GEMINI_API_KEY=your-gemini-api-key-here

# Comma-separated list of frontend origins allowed to call this API.
# Defaults to http://localhost:5173 if unset — set this to your real
# deployed frontend origin(s) in production.
ALLOWED_ORIGINS=http://localhost:5173,https://audit-pilot-ten.vercel.app
